#!/usr/bin/env python3
"""pr-visual: put a dark before-vs-after graphic at the top of a GitHub PR or GitLab MR.

Usage:
  pr-visual <PR/MR URL> [--before-url U --after-url U] [--before TEXT]... [--after TEXT]...
                        [--mock] [--dry-run] [--out FILE]
  pr-visual check <PR/MR URL>        exit 0 if the description has an image in its first lines

UI change: give --before-url and --after-url (base and head deploy/preview URLs).
  The helper takes headless Chrome screenshots at 1280 px and 375 px.
Non-UI change: give short --before / --after lines (what was true, what is true now).
  The helper adds a chart of changed lines per top-level folder from the PR diff.
Never point it at pages with secrets, account, position or NLV data.

Images: GitHub -> private repo jeffscottward/pr-assets (blob ?raw=true link);
GitLab (rig) -> project uploads API. The block sits between <!-- pr-visual --> markers
and is replaced on re-run, so update it when the change moves.
"""
import argparse, base64, html, json, os, re, shutil, subprocess, sys, tempfile, time, urllib.parse, urllib.request
from collections import defaultdict

MARK_A, MARK_B = "<!-- pr-visual -->", "<!-- /pr-visual -->"
ASSETS_REPO = os.environ.get("PR_VISUAL_ASSETS_REPO", "jeffscottward/pr-assets")
GL_API = os.environ.get("PR_VISUAL_GITLAB_API", "http://127.0.0.1:8080/api/v4")
GL_TOKEN_FILE = os.path.expanduser("~/.config/gitlab-rig/token")
CHECK_LINES = 15
IMG_RE = re.compile(r"!\[[^\]]*\]\([^)]+\)|<img\s", re.I)


def die(msg):
    print(f"pr-visual: {msg}", file=sys.stderr)
    sys.exit(2)


def run(cmd, **kw):
    r = subprocess.run(cmd, capture_output=True, text=True, **kw)
    if r.returncode:
        die(f"{cmd[0]} failed: {r.stderr.strip()[:400]}")
    return r.stdout


# ---------- PR sources ----------
class GitHub:
    def __init__(self, owner, repo, num):
        self.slug, self.num = f"{owner}/{repo}", num

    def meta(self):
        d = json.loads(run(["gh", "pr", "view", str(self.num), "-R", self.slug, "--json", "title,body,files,baseRefName,headRefName"]))
        files = [(f["path"], f["additions"], f["deletions"]) for f in d.get("files", [])]
        return d["title"], d.get("body") or "", files

    def upload(self, png):
        path = f"{self.slug.replace('/', '__')}/{self.num}-{int(time.time())}.png"
        payload = json.dumps({"message": f"pr-visual {self.slug}#{self.num}", "content": base64.b64encode(open(png, "rb").read()).decode()})
        subprocess.run(["gh", "api", "-X", "PUT", f"repos/{ASSETS_REPO}/contents/{path}", "--input", "-"], input=payload, capture_output=True, text=True, check=True)
        return f"https://github.com/{ASSETS_REPO}/blob/main/{path}?raw=true"

    def set_body(self, body):
        run(["gh", "api", "-X", "PATCH", f"repos/{self.slug}/pulls/{self.num}", "-f", f"body={body}"])


class GitLab:
    def __init__(self, path, iid):
        self.pid, self.iid = urllib.parse.quote(path, safe=""), iid
        try:
            self.token = os.environ.get("GITLAB_TOKEN") or open(GL_TOKEN_FILE).read().strip()
        except OSError:
            die("no GitLab token (GITLAB_TOKEN or ~/.config/gitlab-rig/token)")

    def _req(self, method, url, data=None, headers=None):
        req = urllib.request.Request(GL_API + url, data=data, method=method, headers={"PRIVATE-TOKEN": self.token, **(headers or {})})
        with urllib.request.urlopen(req, timeout=60) as r:
            return json.loads(r.read())

    def meta(self):
        mr = self._req("GET", f"/projects/{self.pid}/merge_requests/{self.iid}")
        ch = self._req("GET", f"/projects/{self.pid}/merge_requests/{self.iid}/changes")
        files = []
        for c in ch.get("changes", []):
            lines = c.get("diff", "").splitlines()
            a = sum(1 for l in lines if l.startswith("+") and not l.startswith("+++"))
            d = sum(1 for l in lines if l.startswith("-") and not l.startswith("---"))
            files.append((c["new_path"], a, d))
        return mr["title"], mr.get("description") or "", files

    def upload(self, png):
        bnd = "----prvisual" + str(int(time.time()))
        body = (f"--{bnd}\r\nContent-Disposition: form-data; name=\"file\"; filename=\"pr-visual.png\"\r\nContent-Type: image/png\r\n\r\n").encode() + open(png, "rb").read() + f"\r\n--{bnd}--\r\n".encode()
        r = self._req("POST", f"/projects/{self.pid}/uploads", body, {"Content-Type": f"multipart/form-data; boundary={bnd}"})
        return r["url"]  # project-relative /uploads/... ; GitLab renders it in the MR description

    def set_body(self, body):
        self._req("PUT", f"/projects/{self.pid}/merge_requests/{self.iid}", json.dumps({"description": body}).encode(), {"Content-Type": "application/json"})


def source_for(url):
    u = urllib.parse.urlparse(url)
    m = re.match(r"^/([^/]+)/([^/]+)/pull/(\d+)", u.path)
    if u.netloc.endswith("github.com") and m:
        return GitHub(m[1], m[2], int(m[3]))
    m = re.match(r"^/(.+?)/-/merge_requests/(\d+)", u.path)
    if m:
        return GitLab(m[1], int(m[2]))
    die(f"not a GitHub PR or GitLab MR URL: {url}")


# ---------- rendering ----------
def chrome():
    for c in ("google-chrome-stable", "chromium", "google-chrome", "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"):
        p = shutil.which(c) or (c if os.path.exists(c) else None)
        if p:
            return p
    die("no Chrome/Chromium found")


def shoot(url, out, w, h):
    subprocess.run([chrome(), "--headless=new", "--disable-gpu", "--hide-scrollbars", "--force-dark-mode",
                    "--blink-settings=preferredColorScheme=0", f"--window-size={w},{h}", "--virtual-time-budget=8000",
                    f"--screenshot={out}", url], capture_output=True, timeout=90)
    if not os.path.exists(out):
        die(f"screenshot failed for {url}")


def uri(p):
    return "data:image/png;base64," + base64.b64encode(open(p, "rb").read()).decode()


def chart(files):
    agg = defaultdict(lambda: [0, 0])
    for p, a, d in files:
        k = p.split("/")[0] if "/" in p else "(root)"
        agg[k][0] += a; agg[k][1] += d
    rows = sorted(agg.items(), key=lambda kv: -(kv[1][0] + kv[1][1]))[:8]
    if not rows:
        return ""
    mx = max(a + d for _, (a, d) in rows) or 1
    out = []
    for i, (k, (a, d)) in enumerate(rows):
        y = 10 + i * 34
        wa, wd = 520 * a / mx, 520 * d / mx
        out.append(f'<text x="0" y="{y+17}" fill="#c9d1d9" font-size="15">{html.escape(k[:26])}</text>'
                   f'<rect x="230" y="{y}" width="{wd:.0f}" height="24" rx="4" fill="#f85149"/>'
                   f'<rect x="{230+wd:.0f}" y="{y}" width="{wa:.0f}" height="24" rx="4" fill="#3fb950"/>'
                   f'<text x="{240+wa+wd:.0f}" y="{y+17}" fill="#8b949e" font-size="14">−{d} / +{a}</text>')
    h = 20 + len(rows) * 34
    return (f'<div class="chart"><div class="ch">📊 Changed lines per folder (<span style="color:#f85149">removed</span> / '
            f'<span style="color:#3fb950">added</span>)</div><svg width="1100" height="{h}">{"".join(out)}</svg></div>')


CSS = """body{margin:0;background:#0d1117;color:#e6edf3;font:16px -apple-system,Segoe UI,Helvetica,Arial,sans-serif}
.wrap{padding:28px 32px}.t{font-size:24px;font-weight:700;margin-bottom:18px}.mock{display:inline-block;background:#d29922;color:#000;
font-weight:800;padding:2px 10px;border-radius:6px;margin-left:12px}.cols{display:flex;gap:24px;align-items:stretch}
.col{flex:1;background:#161b22;border:2px solid #30363d;border-radius:14px;padding:18px}.b{border-color:#f8514966}.a{border-color:#3fb95088}
.h{font-size:22px;font-weight:800;margin-bottom:12px}.b .h{color:#f85149}.a .h{color:#3fb950}.arrow{align-self:center;font-size:56px;color:#58a6ff}
ul{margin:0;padding-left:0;list-style:none}li{font-size:18px;margin:10px 0;line-height:1.35}.b li:before{content:"✗ ";color:#f85149}
.a li:before{content:"✓ ";color:#3fb950}.shots{display:flex;gap:12px;align-items:flex-start}.shots img{border:1px solid #30363d;border-radius:8px}
.chart{margin-top:22px;background:#161b22;border:1px solid #30363d;border-radius:14px;padding:16px 18px}.ch{color:#8b949e;margin-bottom:8px}"""


def build_html(title, mock, before, after, shots, files):
    def col(cls, label, items, imgs):
        inner = ""
        if imgs:
            inner += '<div class="shots">' + "".join(f'<img src="{uri(p)}" width="{w}">' for p, w in imgs) + "</div>"
        if items:
            inner += "<ul>" + "".join(f"<li>{html.escape(x)}</li>" for x in items) + "</ul>"
        return f'<div class="col {cls}"><div class="h">{label}</div>{inner}</div>'
    m = '<span class="mock">MOCK</span>' if mock else ""
    return (f"<html><head><meta charset=utf-8><style>{CSS}</style></head><body><div class=wrap id=root>"
            f'<div class="t">{html.escape(title)}{m}</div><div class="cols">'
            f'{col("b", "⏮ BEFORE", before, shots.get("before"))}<div class="arrow">➜</div>{col("a", "⏭ AFTER", after, shots.get("after"))}'
            f"</div>{chart(files)}</div></body></html>")


def render(htmlsrc, out):
    d = tempfile.mkdtemp(prefix="prvis-")
    hp = os.path.join(d, "v.html")
    open(hp, "w").write(htmlsrc)
    height = 1400 if "<img" in htmlsrc else 900
    shoot("file://" + hp, out, 1240, height)
    trim(out)
    return out


def trim(png):
    """Cut the empty dark area under the content (Chrome renders a fixed window size)."""
    try:
        from PIL import Image, ImageChops
        im = Image.open(png).convert("RGB")
        bg = Image.new("RGB", im.size, (13, 17, 23))
        box = ImageChops.difference(im, bg).getbbox()
        if box:
            im.crop((0, 0, im.width, min(im.height, box[3] + 28))).save(png)
    except ImportError:
        if shutil.which("magick"):
            subprocess.run(["magick", png, "-gravity", "north", "-background", "#0d1117", "-trim", "+repage",
                            "-bordercolor", "#0d1117", "-border", "28", png], capture_output=True)


def with_block(body, img_md):
    body = re.sub(re.escape(MARK_A) + r".*?" + re.escape(MARK_B) + r"\n*", "", body, flags=re.S)
    return f"{MARK_A}\n{img_md}\n{MARK_B}\n\n{body.lstrip()}"


def has_visual(body):
    head = "\n".join(body.splitlines()[:CHECK_LINES])
    return bool(IMG_RE.search(head))


def main():
    if len(sys.argv) > 1 and sys.argv[1] == "check":
        if len(sys.argv) < 3:
            die("usage: pr-visual check <URL>")
        _, body, _ = source_for(sys.argv[2]).meta()
        ok = has_visual(body)
        print("pr-visual check: " + ("OK, image in the first lines" if ok else f"MISSING: no image in the first {CHECK_LINES} lines of the description"))
        sys.exit(0 if ok else 1)
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("url")
    ap.add_argument("--before-url"); ap.add_argument("--after-url")
    ap.add_argument("--before", action="append", default=[]); ap.add_argument("--after", action="append", default=[])
    ap.add_argument("--mock", action="store_true", help="label the graphic MOCK (mock data or mock screenshots)")
    ap.add_argument("--dry-run", action="store_true", help="render only; do not upload or edit the PR")
    ap.add_argument("--out")
    a = ap.parse_args()
    if bool(a.before_url) != bool(a.after_url):
        die("give both --before-url and --after-url")
    if not (a.before_url or a.before or a.after):
        die("give --before-url/--after-url (UI change) or --before/--after lines (non-UI change)")
    src = source_for(a.url)
    title, body, files = src.meta()
    shots = {}
    if a.before_url:
        tmp = tempfile.mkdtemp(prefix="prvis-shots-")
        for side, u in (("before", a.before_url), ("after", a.after_url)):
            dp, mp = f"{tmp}/{side}-d.png", f"{tmp}/{side}-m.png"
            shoot(u, dp, 1280, 800); shoot(u, mp, 375, 812)
            shots[side] = [(dp, 380), (mp, 112)]
    out = a.out or os.path.join(tempfile.mkdtemp(prefix="prvis-"), "pr-visual.png")
    render(build_html(title, a.mock, a.before, a.after, shots, files), out)
    print(f"pr-visual: rendered {out}")
    if a.dry_run:
        return
    link = src.upload(out)
    alt = "Before vs after (MOCK)" if a.mock else "Before vs after"
    src.set_body(with_block(body, f"![{alt}]({link})"))
    print(f"pr-visual: graphic at the top of {a.url}")


if __name__ == "__main__":
    main()
